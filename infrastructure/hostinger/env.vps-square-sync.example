# VPS-only Square -> Supabase/PostgreSQL synchronization environment.
#
# Never import this file into Hostinger and never commit a populated copy. The
# populated file belongs outside the release tree with root:root ownership,
# mode 0600, one link, and no output that prints its values.

# Use a dedicated writer role for the Square projection. Do not use the
# storefront_runtime role and do not use the Supabase postgres owner role.
# A persistent VPS process may use Supavisor session mode on port 5432.
DATABASE_URL=postgresql://storefront_sync.PROJECT_REF:CHANGE_ME_SYNC_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=10
DIRECT_URL=postgresql://storefront_sync.PROJECT_REF:CHANGE_ME_SYNC_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=2&pool_timeout=10

SQUARE_ENVIRONMENT=production
SQUARE_ALLOW_PRODUCTION_READONLY_SYNC=true
SQUARE_CATALOG_SYNC_MAX_AGE_SECONDS=86400
SQUARE_INVENTORY_SYNC_MAX_AGE_SECONDS=1800
SQUARE_ACCESS_TOKEN=CHANGE_ME_PRODUCTION_READ_TOKEN

E2E_CATALOG_FIXTURE=false
SQUARE_CHECKOUT_ENABLED=false
SQUARE_RETURNS_REFUNDS_ENABLED=false
ORDERPRO_LOCAL_DELIVERY_CHECKOUT_ENABLED=false
ORDERPRO_SHIPPING_CHECKOUT_ENABLED=false
ORDERPRO_RETURNS_ENABLED=false
ALLOW_LOCAL_PERSISTENCE_FALLBACK=false
