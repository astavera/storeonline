# Hostinger Node.js Web App: authenticated real-catalog admin preview.
#
# Import this shape in Hostinger only after replacing every CHANGE_ME value.
# Hostinger runs the Storefront application; it never synchronizes Square and
# must not receive a Square access token or an OrderPRO service credential.

NEXT_PUBLIC_SITE_URL=https://CHANGE_ME.hostingersite.com
NEXT_PUBLIC_SITE_INDEXABLE=false

STOREFRONT_DESIGN_PREVIEW=false
STOREFRONT_ADMIN_PREVIEW=true
E2E_CATALOG_FIXTURE=false

# Both URLs use the least-privilege storefront_runtime role. Hostinger must not
# receive the migrator or VPS sync role. Use the Supavisor host and project ref
# shown by the Supabase Connect dialog. Port 6543 is transaction mode; port
# 5432 is session mode. Percent-encode special characters in the password.
DATABASE_URL=postgresql://storefront_runtime.PROJECT_REF:CHANGE_ME_RUNTIME_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10
DIRECT_URL=postgresql://storefront_runtime.PROJECT_REF:CHANGE_ME_RUNTIME_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=10

# Production identifies the catalog snapshot in PostgreSQL. The false sync
# switch and blank credentials make this runtime database-read-only with
# respect to Square.
SQUARE_ENVIRONMENT=production
SQUARE_ALLOW_PRODUCTION_READONLY_SYNC=false
SQUARE_CATALOG_SYNC_MAX_AGE_SECONDS=86400
SQUARE_INVENTORY_SYNC_MAX_AGE_SECONDS=1800
SQUARE_CHECKOUT_ENABLED=false
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
WEBHOOK_WORKER_SECRET=
SQUARE_RETURNS_REFUNDS_ENABLED=false

# The preview contract rejects this CHANGE_ME placeholder even though it is
# longer than 32 characters. Replace it with a cryptographically random value.
ADMIN_SESSION_SECRET=CHANGE_ME_RANDOM_MINIMUM_32_CHARACTERS
ADMIN_LOGIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD_HASH=CHANGE_ME_GENERATED_SCRYPT_HASH
ADMIN_ALLOWED_ORIGINS=https://CHANGE_ME.hostingersite.com
ADMIN_DEV_BYPASS=false

ALLOW_LOCAL_PERSISTENCE_FALLBACK=false
CUSTOMER_AUTH_DEV_PREVIEW=false
RESEND_API_KEY=

ORDERPRO_M2M_AUTH_MODE=DISABLED
ORDERPRO_LOCAL_DELIVERY_CHECKOUT_ENABLED=false
ORDERPRO_SHIPPING_CHECKOUT_ENABLED=false
ORDERPRO_RETURNS_ENABLED=false
ORDERPRO_AUTH0_CLIENT_ID=
ORDERPRO_AUTH0_CLIENT_SECRET=
ORDERPRO_STOREFRONT_PREVIEW_SHARED_SECRET=
ORDERPRO_STOREFRONT_SHIPPING_SHARED_SECRET=
ORDERPRO_STOREFRONT_RETURNS_SHARED_SECRET=

SHIPPO_TEST_MODE=true
SHIPPO_API_TOKEN=
SHIPPO_WEBHOOK_SECRET=
