# Safe Storefront runtime template. Copy it to a private file outside Git,
# replace every CHANGE_ME value, and set mode 0600. This file belongs only to
# the long-running storefront service and must never contain migrator credentials.

# Use the temporary Hostinger hostname until the modernstate.com transfer and
# DNS cutover are explicitly approved.
NEXT_PUBLIC_SITE_URL=https://shop.srv1849559.hstgr.cloud
NEXT_PUBLIC_SITE_INDEXABLE=false
STOREFRONT_DESIGN_PREVIEW=false
STOREFRONT_ADMIN_PREVIEW=false
E2E_CATALOG_FIXTURE=false

STOREFRONT_DATABASE_NETWORK=storefront-production-database
STOREFRONT_ORDERPRO_NETWORK=storefront-orderpro-private
STOREFRONT_GATEWAY_NETWORK=storefront-public-gateway

DATABASE_URL=postgresql://storefront_runtime:CHANGE_ME_RUNTIME_DB_PASSWORD@storefront-postgres:5432/storefront_prod?schema=public&connection_limit=20&pool_timeout=10
DIRECT_URL=postgresql://storefront_runtime:CHANGE_ME_RUNTIME_DB_PASSWORD@storefront-postgres:5432/storefront_prod?schema=public

SQUARE_ENVIRONMENT=production
SQUARE_ALLOW_PRODUCTION_READONLY_SYNC=true
SQUARE_CATALOG_SYNC_MAX_AGE_SECONDS=86400
SQUARE_INVENTORY_SYNC_MAX_AGE_SECONDS=1800
SQUARE_CHECKOUT_ENABLED=false
SQUARE_ACCESS_TOKEN=CHANGE_ME
SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=CHANGE_ME
WEBHOOK_WORKER_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS

ADMIN_SESSION_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
# Production steady state. Use LEGACY_BOOTSTRAP only during the documented,
# one-time first-Owner activation, then return this value to DATABASE.
ADMIN_IDENTITY_MODE=DATABASE
# Ignored in DATABASE mode. Keep these unset after the first Owner activates MFA.
ADMIN_LOGIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_MFA_ENCRYPTION_KEY=CHANGE_ME_BASE64URL_32_BYTES
ADMIN_RECOVERY_CODE_PEPPER=CHANGE_ME_DIFFERENT_MINIMUM_32_BYTES
ADMIN_PUBLIC_URL=https://admin.example.com
ADMIN_PASSWORD_RESET_EMAIL_FROM="Modern State Admin <admin@example.com>"
ADMIN_ALLOWED_ORIGINS=https://shop.srv1849559.hstgr.cloud
ADMIN_DEV_BYPASS=false
ALLOW_LOCAL_PERSISTENCE_FALLBACK=false

CUSTOMER_SESSION_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
CUSTOMER_AUTH_DEV_PREVIEW=false
RESEND_API_KEY=CHANGE_ME
CUSTOMER_AUTH_EMAIL_FROM="Modern State <account@example.com>"
ADMIN_TRANSACTIONAL_NOTIFICATION_PROVIDER=DISABLED

ORDERPRO_ADMIN_URL=https://operation.modernstate.com
OPERATIONS_ACCESS_SYNC_MODE=DISABLED
OPERATIONS_ACCESS_API_BASE_URL=https://operation.modernstate.com
OPERATIONS_ACCESS_API_CONTRACT=ACCESS_ASSIGNMENTS_V1
OPERATIONS_ACCESS_AUTH_MODE=BEARER
OPERATIONS_ACCESS_API_TOKEN=
OPERATIONS_ACCESS_TIMEOUT_MS=5000
ORDERPRO_M2M_AUTH_MODE=DISABLED
ORDERPRO_INTEGRATION_ENVIRONMENT=STAGING
ORDERPRO_API_BASE_URL=http://orderpro-api:3000
ORDERPRO_AUTH0_ISSUER=
ORDERPRO_AUTH0_AUDIENCE=
ORDERPRO_AUTH0_CLIENT_ID=
ORDERPRO_AUTH0_CLIENT_SECRET=
ORDERPRO_AUTH0_SCOPES=local-delivery:holds local-delivery:quote
ORDERPRO_STOREFRONT_FULFILLMENT_BASE_URL=
ORDERPRO_STOREFRONT_FULFILLMENT_AUTH_MODE=AUTH0
ORDERPRO_STOREFRONT_FULFILLMENT_AUTH0_SCOPES="local-delivery:quote local-delivery:reserve local-delivery:settle pickup:quote pickup:reserve pickup:settle"
ORDERPRO_STOREFRONT_PICKUP_QUOTE_SHARED_SECRET=
ORDERPRO_STOREFRONT_PICKUP_RESERVATION_SHARED_SECRET=
ORDERPRO_STOREFRONT_DURABLE_QUOTE_SHARED_SECRET=
ORDERPRO_STOREFRONT_WALKING_RESERVATION_SHARED_SECRET=
ORDERPRO_STOREFRONT_CAPACITY_CHECKOUT_SHARED_SECRET=
ORDERPRO_LOCAL_DELIVERY_CHECKOUT_ENABLED=false
ORDERPRO_SHIPPING_CHECKOUT_ENABLED=false

SHIPPO_API_TOKEN=
SHIPPO_TEST_MODE=true
SHIPPO_WEBHOOK_SECRET=
MAPBOX_ACCESS_TOKEN=
SENTRY_DSN=
