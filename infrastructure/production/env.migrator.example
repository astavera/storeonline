# Private Prisma migrator template. Copy it to a different file outside Git,
# replace the password, and set mode 0600. Do not add runtime application
# secrets to this file.

DATABASE_URL=postgresql://storefront_migrator:CHANGE_ME_MIGRATOR_DB_PASSWORD@storefront-postgres:5432/storefront_prod?schema=public&connection_limit=2&pool_timeout=10
DIRECT_URL=postgresql://storefront_migrator:CHANGE_ME_MIGRATOR_DB_PASSWORD@storefront-postgres:5432/storefront_prod?schema=public
