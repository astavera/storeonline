# Runs the storefront webhook worker through the production container helper.

[Unit]
Description=Process Square webhooks and expire safe Storefront shipping checkouts
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/storefront/current
ExecStart=/srv/storefront/current/infrastructure/production/run-square-job.sh webhook-worker
TimeoutStartSec=60
Nice=5
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/run
