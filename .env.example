# Browser-visible application URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search engines stay blocked until the production domain, content, and launch
# checklist are approved. Set true only for the public production release.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Temporary public maintenance page. Customer-facing pages are rewritten to a
# static no-index page while admin pages, health checks, and APIs stay online.
STOREFRONT_MAINTENANCE_MODE=false

# Hosted design-only preview. This uses built-in read-only content only when
# E2E_CATALOG_FIXTURE=true and every checkout/refund gate remains disabled.
STOREFRONT_DESIGN_PREVIEW=false
# Authenticated Hostinger admin preview. Requires a real PostgreSQL catalog and
# private admin credentials while blocking every customer/integration mutation
# outside the exact homepage allowlist. E2E fixtures remain test-only.
STOREFRONT_ADMIN_PREVIEW=false
E2E_CATALOG_FIXTURE=false

# PostgreSQL for local development only. Production Docker Compose requires
# separate `env.runtime.example` and `env.migrator.example` contracts so the
# `storefront_runtime` and `storefront_migrator` roles never share a file.
# For Supabase development, use the transaction pooler URL with
# ?pgbouncer=true for runtime, and the session pooler or direct URL for Prisma
# migrations. Keep both values server-only.
DATABASE_URL=postgresql://modern_state:modern_state@localhost:5432/modern_state
DIRECT_URL=postgresql://modern_state:modern_state@localhost:5432/modern_state

# Square Sandbox is mandatory for app development, CI, and ordinary previews.
# The authenticated admin preview may read a production catalog snapshot only
# from PostgreSQL: it sets SQUARE_ENVIRONMENT=production while keeping the
# production sync switch false and omitting every Square credential.
SQUARE_ENVIRONMENT=sandbox
# Separate kill switch for catalog/inventory reads against the real seller.
# This never authorizes Square orders, inventory changes, or payments.
SQUARE_ALLOW_PRODUCTION_READONLY_SYNC=false
# A completed catalog snapshot is accepted for at most 24 hours by default.
# Inventory is stricter because quantities change frequently. Both values are
# server-only integers from 60 through 86400 seconds.
SQUARE_CATALOG_SYNC_MAX_AGE_SECONDS=86400
SQUARE_INVENTORY_SYNC_MAX_AGE_SECONDS=1800
# Separate, explicit kill switch for hosted Square Checkout. When true, a
# validated customer checkout can create a Square order and payment link.
# Keep false until the live locations, token, taxes, fulfillment modes, and
# rollback procedure have been verified.
SQUARE_CHECKOUT_ENABLED=false
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Secret used by the scheduler that invokes the durable inbox worker.
WEBHOOK_WORKER_SECRET=

# Bounded read-only live catalog audit (1-10 pages, default 2).
SQUARE_CATALOG_TEST_MAX_PAGES=2

# Shipping, maps, and observability.
SHIPPO_API_TOKEN=
SHIPPO_TEST_MODE=true
# Private shipping pilot. The live API token is server-only and never buys a
# label in the checkout flow. Carrier labels remain a separate manual action.
SHIPPO_ALLOWED_CARRIERS=usps
SHIPPO_ALLOWED_RETURN_CARRIERS=usps
SHIPPO_DEFAULT_RETURN_SERVICE=usps_ground_advantage
SHIPPO_RETURN_ADDRESS_NAME=Modern State Returns - WH01
SHIPPO_RETURN_ADDRESS_LINE1=
SHIPPO_RETURN_ADDRESS_LINE2=
SHIPPO_RETURN_ADDRESS_CITY=
SHIPPO_RETURN_ADDRESS_STATE=NY
SHIPPO_RETURN_ADDRESS_ZIP=
SHIPPO_RETURN_ADDRESS_COUNTRY=US
# Random server-only secret used to authenticate Shippo webhook ingress.
SHIPPO_WEBHOOK_SECRET=
SHIPPO_PILOT_VARIATION_IDS=
SHIPPO_ORIGIN_NAME=
SHIPPO_ORIGIN_COMPANY=
SHIPPO_ORIGIN_STREET1=
SHIPPO_ORIGIN_STREET2=
SHIPPO_ORIGIN_CITY=
SHIPPO_ORIGIN_STATE=
SHIPPO_ORIGIN_ZIP=
SHIPPO_ORIGIN_COUNTRY=US
SHIPPO_ORIGIN_PHONE=
SHIPPO_ORIGIN_EMAIL=
SHIPPO_PILOT_LENGTH_IN=10
SHIPPO_PILOT_WIDTH_IN=5
SHIPPO_PILOT_HEIGHT_IN=6
SHIPPO_PILOT_WEIGHT_LB=0.50
MAPBOX_ACCESS_TOKEN=
SENTRY_DSN=

# Admin stays fail-closed until all three login values are configured.
# Use a random session secret of at least 32 bytes.
ADMIN_SESSION_SECRET=
ADMIN_LOGIN_EMAIL=
# Generate with the command below. In local .env files, escape each $ as \$.
# npm run admin:hash-password -- "your-long-password"
ADMIN_PASSWORD_HASH=
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
# Explicit local-only escape hatch; never enable in preview or production.
ADMIN_DEV_BYPASS=false

# External operations dashboard. Orders, fulfillment and available slots are managed there.
ORDERPRO_ADMIN_URL=

# Development-only JSON persistence. Production and preview ignore this flag.
ALLOW_LOCAL_PERSISTENCE_FALLBACK=false

# Passwordless customer accounts. Production requires PostgreSQL, a private
# session secret, and a verified Resend sender. Development uses an isolated
# in-memory preview unless CUSTOMER_AUTH_DEV_PREVIEW=false.
CUSTOMER_SESSION_SECRET=
CUSTOMER_AUTH_DEV_PREVIEW=true
RESEND_API_KEY=
CUSTOMER_AUTH_EMAIL_FROM="Modern State <account@example.com>"

# OrderPRO STAGING M2M (server-only; never prefix these with NEXT_PUBLIC_)
ORDERPRO_M2M_AUTH_MODE=DISABLED
ORDERPRO_INTEGRATION_ENVIRONMENT=STAGING
ORDERPRO_API_BASE_URL=https://orderpro-staging.vercel.app
ORDERPRO_AUTH0_ISSUER=https://dev-rfzzpvgkfg1mwf3m.us.auth0.com/
ORDERPRO_AUTH0_AUDIENCE=https://api.orderpro.internal/local-delivery/staging
ORDERPRO_AUTH0_CLIENT_ID=
ORDERPRO_AUTH0_CLIENT_SECRET=
ORDERPRO_AUTH0_SCOPES=local-delivery:holds local-delivery:quote
# Private, read-only OrderPRO preview connection. The base URL is server-only
# (for Docker on the VPS: http://orderpro:3000). Share the secret only with
# OrderPRO; never expose either value through NEXT_PUBLIC_ variables.
ORDERPRO_STOREFRONT_PREVIEW_BASE_URL=
ORDERPRO_STOREFRONT_PREVIEW_SHARED_SECRET=
# Separate server-only credential for OrderPRO shipping order mutations.
ORDERPRO_STOREFRONT_SHIPPING_SHARED_SECRET=
# Dedicated OrderPRO credential and kill switch for return verification, RMA,
# inspection, and inventory events.
ORDERPRO_STOREFRONT_RETURNS_SHARED_SECRET=
ORDERPRO_RETURNS_ENABLED=false
# HMAC secret for short-lived return sessions and quote acceptance tokens.
RETURNS_SESSION_SECRET=
RETURNS_BUSINESS_TIME_ZONE=America/New_York
# Refund writes are Sandbox-only and require this separate fail-closed switch.
SQUARE_RETURNS_REFUNDS_ENABLED=false
ORDERPRO_LOCAL_DELIVERY_CHECKOUT_ENABLED=false
# Separate fail-closed switch for the OrderPRO + Shippo shipping checkout.
ORDERPRO_SHIPPING_CHECKOUT_ENABLED=false

# Destination-aware tax is a separate fail-closed shipping switch. Stripe Tax
# calculates tax while Square remains the payment processor. Start with an
# sk_test_ key and configure Stripe Tax registrations in its test environment.
DESTINATION_TAX_ENABLED=false
STRIPE_TAX_SECRET_KEY=
# Approved Stripe Tax codes (txcd_########). The default product code is used
# only for Square items marked taxable; non-taxable items require an explicit
# per-product override. Configure the shipping code from Stripe's tax-code list.
STRIPE_TAX_DEFAULT_PRODUCT_CODE=
STRIPE_TAX_SHIPPING_CODE=
# Separate switch for committing completed Square sales to Stripe Tax reporting.
STRIPE_TAX_REPORTING_ENABLED=false
# Independent random server-only secret (at least 32 characters) for short-lived
# TaxQuote tokens. Do not reuse Square, Shippo, Stripe, or session credentials.
TAX_QUOTE_SIGNING_SECRET=
