# Browser-visible application URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Use a disposable local database outside production.
DATABASE_URL=postgresql://modern_state:modern_state@localhost:5432/modern_state

# Square Sandbox is mandatory for local, CI, and preview.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Shipping, maps, and observability.
SHIPPO_API_TOKEN=
MAPBOX_ACCESS_TOKEN=
SENTRY_DSN=

# Reserved for the later admin authentication phase.
ADMIN_SESSION_SECRET=
