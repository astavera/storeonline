{
  "name": "modern-state-ecommerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=51",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:orderpro": "eslint scripts/run-orderpro-live-test.mjs src/server/orderpro src/app/api/checkout/route.ts \"src/app/(checkout)/checkout/page.tsx\" src/components/checkout/checkout-client.tsx src/components/checkout/checkout-page-template.tsx src/tests/unit/orderpro-config.test.ts src/tests/unit/orderpro-token-provider.test.ts src/tests/integration/orderpro-client.test.ts src/tests/integration/orderpro-auth-check.live.test.ts src/tests/integration/checkout-local-delivery-guard.test.ts --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run lint:orderpro && npm run typecheck && npm run test",
    "verify": "npm run check && npm run build",
    "test": "vitest run --maxWorkers=2 --exclude \"**/*.live.test.ts\"",
    "test:integration:postgres": "vitest run src/tests/integration",
    "test:watch": "vitest",
    "test:square:catalog": "vitest run --config vitest.live.config.ts --reporter=verbose",
    "test:orderpro:live": "node scripts/run-orderpro-live-test.mjs",
    "sync:square:catalog": "node --disable-warning=ExperimentalWarning scripts/sync-square-catalog-read-only.mjs",
    "sync:square:postgres:readonly": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --experimental-transform-types --import ./scripts/register-typescript-alias.mjs scripts/sync-square-postgres-read-only.ts",
    "reconcile:legacy": "node --disable-warning=ExperimentalWarning scripts/reconcile-legacy-state.mjs",
    "import:legacy:content": "node scripts/import-legacy-content.mjs",
    "audit:constraints": "node scripts/audit-operational-constraints.mjs",
    "bootstrap:locations": "node scripts/bootstrap-store-locations.mjs",
    "publish:merchandising": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --experimental-transform-types --import ./scripts/register-typescript-alias.mjs scripts/publish-website-merchandising.ts",
    "rollback:merchandising": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --experimental-transform-types --import ./scripts/register-typescript-alias.mjs scripts/rollback-website-merchandising.ts",
    "prepare:merchandising:no-shipping": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --experimental-transform-types --import ./scripts/register-typescript-alias.mjs scripts/prepare-no-shipping-merchandising-draft.ts",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test src/tests/e2e/admin.spec.ts --project=chromium",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sentry/nextjs": "10.64.0",
    "@square/web-sdk": "2.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.42.2",
    "lucide-react": "1.23.0",
    "mapbox-gl": "3.25.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "read-excel-file": "9.3.1",
    "server-only": "0.0.1",
    "shippo": "2.18.0",
    "square": "45.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "postcss": "8.5.25",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch@3.1.5": {
      "brace-expansion": "2.0.2"
    },
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
