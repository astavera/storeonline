// Defines the PostgreSQL data model and generated Prisma client used by the storefront.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FulfillmentMode {
  PICKUP
  LOCAL_DELIVERY
  SHIPPING
}

enum FulfillmentStatus {
  NEW
  PAID
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  WAREHOUSE_PICKING
  PACKED
  LABEL_CREATED
  SHIPPED
  CANCELLED
  FAILED
}

enum AdminRole {
  OWNER
  MANAGER
  MERCHANDISER
  MARKETING_CONTENT
  CUSTOMER_SUPPORT
  ANALYST_VIEWER
  // Legacy operational values remain temporarily for existing fulfillment rows.
  // They are not accepted as Store Admin identity roles by the RBAC layer.
  STORE_STAFF
  DELIVERY_STAFF
  WAREHOUSE_STAFF
  VIEWER
}

enum AdminUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AdminLocationScopeMode {
  ALL
  LOCATIONS
}

enum OperationsRole {
  OPERATIONS_MANAGER
  STORE_STAFF
  FULFILLMENT
  DELIVERY
  WAREHOUSE
}

enum OperationsAccessStatus {
  NONE
  PENDING
  ACTIVE
  REVOKING
  FAILED
  UNAVAILABLE
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

enum CustomerPrivacyRequestType {
  DATA_EXPORT
  DELETION
}

enum CustomerPrivacyRequestStatus {
  REQUESTED
  IN_REVIEW
  COMPLETED
  REJECTED
}

enum CmsPublishStatus {
  DRAFT
  PREVIEW
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ProductWebStatus {
  DRAFT
  NEEDS_REVIEW
  NEEDS_PLACEMENT
  PUBLISHED
  HIDDEN
  ARCHIVED_WEB_ONLY
}

enum ProductPlacementType {
  DEPARTMENT
  HOLIDAY
  BALLOON_SECTION
  HOMEPAGE_SECTION
  PRODUCT_GROUP
  SEARCH_GROUP
  PROMO_SECTION
}

enum DescriptionSource {
  SQUARE
  WEBSITE_OVERRIDE
  GENERATED_DRAFT
  ADMIN_APPROVED
  EMPTY
}

enum DescriptionStatus {
  READY
  NEEDS_REVIEW
  MISSING
  OUTDATED_SQUARE_CHANGED
}

enum CheckoutAttemptStatus {
  RECEIVED
  VALIDATING
  VALIDATED
  REJECTED
  EXPIRED
  COMPLETED
}

enum TaxQuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  INVALIDATED
}

enum TaxApplicationMode {
  SQUARE_CATALOG_AUTO
  EXPLICIT_DESTINATION_TAX
}

enum TaxNexusDecision {
  COLLECT
  DO_NOT_COLLECT
  UNKNOWN
}

enum WebhookInboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum CapacityHoldStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum BalloonDraftStatus {
  DRAFT
  SUBMITTED
  QUOTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum BalloonQuoteStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  SUPERSEDED
}

enum ReturnRequestStatus {
  REQUESTED
  MANUAL_REVIEW
  AUTHORIZED
  LABEL_PENDING
  LABEL_CREATED
  DROPPED_OFF
  IN_TRANSIT
  DELIVERED_TO_WH01
  RECEIVED
  INSPECTING
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  REFUND_PENDING
  REFUNDED
  COMPLETED
  CANCELLED
  EXCEPTION
}

enum ReturnLineDecision {
  ELIGIBLE
  MANUAL_REVIEW
  INELIGIBLE
  AUTHORIZED
  APPROVED
  REJECTED
}

enum ReturnLabelPayer {
  COMPANY
  CUSTOMER
  PENDING_REVIEW
}

model StoreLocation {
  id                         String                   @id @default(cuid())
  squareLocationId           String?                  @unique
  slug                       String                   @unique
  name                       String
  address                    String
  locality                   String                   @default("")
  phone                      String?
  hours                      String                   @default("")
  notes                      String                   @default("")
  publicVisible              Boolean                  @default(true)
  displayOrder               Int                      @default(0)
  pickupEnabled              Boolean                  @default(true)
  localDeliveryEnabled       Boolean                  @default(true)
  shippingFulfillmentEnabled Boolean                  @default(false)
  archivedAt                 DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  deliveryZones              DeliveryZone[]
  slotTemplates              SlotTemplate[]
  fulfillmentTasks           FulfillmentTask[]
  adminUsers                 AdminUser[]
  adminUserScopes            AdminUserLocationScope[]
  balloonOrderDrafts         BalloonOrderDraft[]

  @@index([publicVisible, archivedAt, displayOrder])
}

model SquareCatalogObject {
  id                      String                   @id
  type                    String
  version                 BigInt?
  reportingCategoryId     String?
  categoryIds             String[]
  name                    String?
  descriptionHtml         String?
  descriptionPlaintext    String?
  squareDescriptionHash   String?
  lastDescriptionSyncedAt DateTime?
  raw                     Json
  syncedAt                DateTime                 @default(now())
  deletedAt               DateTime?
  itemVariations          SquareItemVariation[]
  images                  ProductImagePreference[]
}

model SquareItemVariation {
  id                    String                        @id
  itemId                String
  name                  String
  sku                   String?
  upc                   String?
  priceMoney            Json?
  raw                   Json
  syncedAt              DateTime                      @default(now())
  deletedAt             DateTime?
  item                  SquareCatalogObject           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryCounts       SquareInventoryCount[]
  departmentAssignments ProductDepartmentAssignment[]
  holidayAssignments    ProductHolidayAssignment[]
  brandAssignments      ProductBrandAssignment[]
  productOverride       ProductOverride?
  cartItems             CartItem[]
  orderItems            OrderItemMirror[]
  balloonDraftLines     BalloonDraftLine[]

  @@index([itemId])
  @@index([deletedAt])
}

model SquareInventoryCount {
  id               String              @id @default(cuid())
  variationId      String
  squareLocationId String
  quantity         Decimal
  state            String
  calculatedAt     DateTime
  syncedAt         DateTime            @default(now())
  variation        SquareItemVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@unique([variationId, squareLocationId, state])
  @@index([squareLocationId, state])
}

model SquareCatalogSyncState {
  environment     String    @id
  latestTime      String?
  lastStartedAt   DateTime?
  lastCompletedAt DateTime?
  lastError       String?
  lockedAt        DateTime?
  lockToken       String?
  updatedAt       DateTime  @updatedAt
}

model Department {
  id                 String                        @id @default(cuid())
  slug               String                        @unique
  titleEn            String
  shortTitleEn       String
  descriptionEn      String
  heroTitleEn        String
  heroSubtitleEn     String
  seoTitleEn         String
  seoDescriptionEn   String
  heroImageUrl       String?
  mobileHeroImageUrl String?
  accentColorToken   String
  sortOrder          Int
  navigationPriority String
  isPrimaryNav       Boolean                       @default(false)
  isVisible          Boolean                       @default(true)
  layoutPreset       String
  productGridPreset  String
  productCardVariant String
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  products           ProductDepartmentAssignment[]
}

model Holiday {
  id                 String                     @id @default(cuid())
  slug               String                     @unique
  titleEn            String
  shortTitleEn       String
  descriptionEn      String
  heroTitleEn        String
  heroSubtitleEn     String
  seoTitleEn         String
  seoDescriptionEn   String
  heroImageUrl       String?
  mobileHeroImageUrl String?
  accentColorToken   String
  customAccentColor  String?
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean                    @default(false)
  isVisible          Boolean                    @default(true)
  sortOrder          Int
  layoutPreset       String
  productGridPreset  String
  productCardVariant String
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  products           ProductHolidayAssignment[]

  @@index([isActive, isVisible, startDate, endDate])
}

model WebsiteBrand {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  name               String
  description        String
  logoUrl            String?
  imageAlt           String?
  squareVendorIds    String[]
  visible            Boolean                  @default(false)
  featuredOnHomepage Boolean                  @default(false)
  returnable         Boolean                  @default(true)
  sortOrder          Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  products           ProductBrandAssignment[]

  @@index([visible, sortOrder])
}

model ProductBrandAssignment {
  id                String              @id @default(cuid())
  brandId           String
  squareVariationId String
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  brand             WebsiteBrand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variation         SquareItemVariation @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)

  @@unique([brandId, squareVariationId])
  @@index([brandId, sortOrder])
  @@index([squareVariationId])
}

model ProductDepartmentAssignment {
  id                String              @id @default(cuid())
  departmentId      String
  squareVariationId String
  sortOrder         Int                 @default(0)
  isFeatured        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  department        Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  variation         SquareItemVariation @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)

  @@unique([departmentId, squareVariationId])
  @@index([squareVariationId])
}

model ProductHolidayAssignment {
  id                String              @id @default(cuid())
  holidayId         String
  squareVariationId String
  sortOrder         Int                 @default(0)
  badge             String?
  createdAt         DateTime            @default(now())
  holiday           Holiday             @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  variation         SquareItemVariation @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)

  @@unique([holidayId, squareVariationId])
  @@index([squareVariationId])
}

model ProductOverride {
  id                            String                    @id @default(cuid())
  squareVariationId             String                    @unique
  webVisible                    Boolean                   @default(false)
  webStatus                     ProductWebStatus          @default(NEEDS_PLACEMENT)
  seoTitleEn                    String?
  seoDescriptionEn              String?
  slug                          String?                   @unique
  displayNameEn                 String?
  webShortDescriptionEn         String?
  webDescriptionEn              String?
  badgeEn                       String?
  featured                      Boolean                   @default(false)
  productCardStyle              String?
  ageGroups                     String[]                  @default([])
  websiteSurfaces               String[]                  @default([])
  fulfillmentModes              FulfillmentMode[]
  pickupAllowed                 Boolean                   @default(false)
  localDeliveryAllowed          Boolean                   @default(false)
  shippingAllowed               Boolean                   @default(false)
  allowedLocationIds            String[]
  warehouseRequired             Boolean                   @default(false)
  inflated                      Boolean                   @default(false)
  fragile                       Boolean                   @default(false)
  requiresBalloonPrep           Boolean                   @default(false)
  prepTimeMinutes               Int?
  capacityPoints                Int?
  descriptionSource             DescriptionSource         @default(EMPTY)
  descriptionStatus             DescriptionStatus         @default(MISSING)
  useSquareDescription          Boolean                   @default(true)
  lockWebDescription            Boolean                   @default(false)
  squareDescriptionHash         String?
  lastSquareDescriptionSyncedAt DateTime?
  isBalloonComponent            Boolean                   @default(false)
  isShippable                   Boolean                   @default(true)
  returnPolicyTags              String[]                  @default([])
  finalSale                     Boolean                   @default(false)
  stripeTaxCode                 String?
  packageLengthIn               Decimal?
  packageWidthIn                Decimal?
  packageHeightIn               Decimal?
  packageWeightLb               Decimal?
  publishedAt                   DateTime?
  unpublishedAt                 DateTime?
  scheduledPublishAt            DateTime?
  scheduledUnpublishAt          DateTime?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  variation                     SquareItemVariation       @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)
  placements                    WebsiteProductPlacement[]

  @@index([webStatus, webVisible])
}

model WebsiteProductPlacement {
  id                  String               @id @default(cuid())
  squareVariationId   String
  placementType       ProductPlacementType
  placementTargetId   String?
  placementTargetSlug String
  sectionId           String
  sortOrder           Int                  @default(0)
  isFeatured          Boolean              @default(false)
  isPrimary           Boolean              @default(false)
  visible             Boolean              @default(false)
  startsAt            DateTime?
  endsAt              DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  productOverride     ProductOverride      @relation(fields: [squareVariationId], references: [squareVariationId], onDelete: Cascade)

  @@index([placementType, placementTargetSlug])
  @@index([placementType, placementTargetSlug, visible, sortOrder])
  @@index([squareVariationId])
}

model ProductPlacementRule {
  id                    String               @id @default(cuid())
  name                  String
  active                Boolean              @default(true)
  suggestOnly           Boolean              @default(true)
  matchField            String
  matchOperator         String
  matchValue            String
  placementType         ProductPlacementType
  placementTargetSlug   String
  fulfillmentSuggestion Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model CmsContentVersion {
  id                   String              @id @default(cuid())
  entityType           String
  entityId             String
  versionNumber        Int
  status               CmsPublishStatus    @default(DRAFT)
  title                String?
  payload              Json
  createdById          String?
  publishedById        String?
  publishedAt          DateTime?
  scheduledPublishAt   DateTime?
  scheduledUnpublishAt DateTime?
  rollbackOfVersionId  String?
  createdAt            DateTime            @default(now())
  createdBy            AdminUser?          @relation("CmsVersionCreatedBy", fields: [createdById], references: [id])
  publishedBy          AdminUser?          @relation("CmsVersionPublishedBy", fields: [publishedById], references: [id])
  rollbackOfVersion    CmsContentVersion?  @relation("CmsVersionRollback", fields: [rollbackOfVersionId], references: [id], onDelete: SetNull)
  rollbackVersions     CmsContentVersion[] @relation("CmsVersionRollback")

  @@unique([entityType, entityId, versionNumber])
  @@index([entityType, entityId, status])
  @@index([createdById])
  @@index([publishedById])
  @@index([rollbackOfVersionId])
}

model MediaAsset {
  id                String   @id @default(cuid())
  source            String
  sourceId          String?
  url               String
  altTextEn         String?
  mimeType          String?
  width             Int?
  height            Int?
  hiddenFromWebsite Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([source, sourceId])
}

model ProductImagePreference {
  id              String              @id @default(cuid())
  catalogObjectId String
  imageUrl        String
  altTextEn       String?
  sortOrder       Int                 @default(0)
  isPrimary       Boolean             @default(false)
  cropPreset      String?
  createdAt       DateTime            @default(now())
  catalogObject   SquareCatalogObject @relation(fields: [catalogObjectId], references: [id], onDelete: Cascade)

  @@index([catalogObjectId])
}

model Cart {
  id               String            @id @default(cuid())
  sessionId        String            @unique
  currency         String            @default("USD")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            CartItem[]
  slotHolds        SlotHold[]
  checkoutAttempts CheckoutAttempt[]
  capacityHolds    CapacityHold[]
}

model CartItem {
  id                String              @id @default(cuid())
  cartId            String
  squareVariationId String
  quantity          Int
  fulfillmentMode   FulfillmentMode?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cart              Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variation         SquareItemVariation @relation(fields: [squareVariationId], references: [id])

  @@index([cartId])
  @@index([squareVariationId])
}

model OrderMirror {
  id                                String              @id @default(cuid())
  squareOrderId                     String?             @unique
  squarePaymentId                   String?             @unique
  customerEmail                     String?
  customerPhone                     String?
  currency                          String              @default("USD")
  totalMoney                        Json
  status                            String
  estimatedMerchandiseSubtotalCents Int?
  estimatedDiscountCents            Int?
  estimatedShippingFeeCents         Int?
  estimatedDeliveryFeeCents         Int?
  estimatedMerchandiseTaxCents      Int?
  estimatedShippingTaxCents         Int?
  estimatedDeliveryFeeTaxCents      Int?
  estimatedTotalTaxCents            Int?
  estimatedTotalCents               Int?
  finalMerchandiseSubtotalCents     Int?
  finalDiscountCents                Int?
  finalShippingFeeCents             Int?
  finalDeliveryFeeCents             Int?
  finalMerchandiseTaxCents          Int?
  finalShippingTaxCents             Int?
  finalDeliveryFeeTaxCents          Int?
  finalTotalTaxCents                Int?
  finalTotalCents                   Int?
  taxProvider                       String?
  taxApplicationMode                TaxApplicationMode?
  squareTaxSnapshot                 Json?
  squareFinancialSnapshot           Json?
  taxReconciledAt                   DateTime?
  createdAt                         DateTime            @default(now())
  updatedAt                         DateTime            @updatedAt
  items                             OrderItemMirror[]
  fulfillmentTasks                  FulfillmentTask[]
  slotHolds                         SlotHold[]
  capacityHolds                     CapacityHold[]

  @@index([status, createdAt])
}

model OrderItemMirror {
  id                      String              @id @default(cuid())
  orderId                 String
  squareVariationId       String
  squareLineItemUid       String?
  name                    String
  quantity                Int
  priceMoney              Json
  finalGrossSalesCents    Int?
  finalDiscountCents      Int?
  finalTaxableAmountCents Int?
  finalTaxCents           Int?
  finalNetTotalCents      Int?
  squareAppliedTaxes      Json?
  squareAppliedDiscounts  Json?
  squareFinancialSnapshot Json?
  order                   OrderMirror         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variation               SquareItemVariation @relation(fields: [squareVariationId], references: [id])

  @@index([orderId])
  @@index([squareVariationId])
  @@index([squareLineItemUid])
}

model FulfillmentTask {
  id              String            @id @default(cuid())
  orderId         String
  locationId      String?
  mode            FulfillmentMode
  status          FulfillmentStatus @default(NEW)
  assignedRole    AdminRole?
  capacityPoints  Int               @default(1)
  deliveryAddress Json?
  shippingAddress Json?
  trackingNumber  String?
  carrier         String?
  labelUrl        String?
  dueAt           DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           OrderMirror       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  location        StoreLocation?    @relation(fields: [locationId], references: [id])

  @@index([orderId])
  @@index([locationId])
  @@index([status, dueAt])
}

model DeliveryZone {
  id                String                @id @default(cuid())
  locationId        String
  name              String
  polygonGeojson    Json
  version           Int                   @default(1)
  active            Boolean               @default(true)
  serviceMode       String
  baseFeeCents      Int
  minimumOrderCents Int
  maxDistanceMiles  Decimal?
  maxRouteMinutes   Int?
  priority          Int                   @default(0)
  activeDays        String[]
  cutoffMinutes     Int
  leadTimeMinutes   Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  location          StoreLocation         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  versions          DeliveryZoneVersion[]

  @@index([locationId])
  @@index([locationId, active, priority])
}

model SlotTemplate {
  id              String           @id @default(cuid())
  locationId      String
  fulfillmentMode FulfillmentMode
  dayOfWeek       Int
  startTime       String
  endTime         String
  capacityPoints  Int
  active          Boolean          @default(true)
  cutoffMinutes   Int
  leadTimeMinutes Int
  location        StoreLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  holds           SlotHold[]
  occurrences     SlotOccurrence[]

  @@index([locationId])
  @@index([locationId, fulfillmentMode, active, dayOfWeek])
}

model SlotHold {
  id             String       @id @default(cuid())
  slotTemplateId String
  cartId         String?
  orderId        String?
  capacityPoints Int
  expiresAt      DateTime
  confirmedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime     @default(now())
  slotTemplate   SlotTemplate @relation(fields: [slotTemplateId], references: [id], onDelete: Restrict)
  cart           Cart?        @relation(fields: [cartId], references: [id], onDelete: Restrict)
  order          OrderMirror? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([slotTemplateId])
  @@index([slotTemplateId, expiresAt])
  @@index([cartId])
  @@index([orderId])
}

model ShippingRateQuote {
  id           String   @id @default(cuid())
  provider     String
  carrier      String
  serviceLevel String
  amountCents  Int
  currency     String   @default("USD")
  addressHash  String
  expiresAt    DateTime
  raw          Json
  createdAt    DateTime @default(now())

  @@index([addressHash, expiresAt])
}

model TaxNexusRule {
  id             String           @id @default(cuid())
  countryCode    String
  stateCode      String
  decision       TaxNexusDecision
  provider       String?
  version        Int              @default(1)
  source         String
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  enabled        Boolean          @default(true)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  taxQuotes      TaxQuote[]

  @@unique([countryCode, stateCode, version], map: "TaxNexusRule_jurisdiction_version_key")
  @@index([countryCode, stateCode, enabled, effectiveFrom, effectiveUntil], map: "TaxNexusRule_active_jurisdiction_idx")
}

model TaxQuote {
  id                       String             @id @default(cuid())
  version                  Int                @default(1)
  signatureVersion         Int                @default(1)
  status                   TaxQuoteStatus     @default(ACTIVE)
  fulfillmentMode          FulfillmentMode
  applicationMode          TaxApplicationMode
  provider                 String
  providerQuoteId          String?
  providerTransactionId    String?            @unique
  providerReportedAt       DateTime?
  currency                 String             @default("USD")
  nexusDecision            TaxNexusDecision
  nexusRuleId              String?
  originSnapshot           Json
  destinationSnapshot      Json
  jurisdictionSnapshot     Json?
  cartHash                 String
  destinationHash          String
  originHash               String
  calculationHash          String
  shippingQuoteId          String?
  shippingRateId           String?
  merchandiseSubtotalCents Int
  discountCents            Int
  shippingFeeCents         Int
  deliveryFeeCents         Int
  taxableMerchandiseCents  Int
  taxableShippingFeeCents  Int
  taxableDeliveryFeeCents  Int
  merchandiseTaxCents      Int
  shippingTaxCents         Int
  deliveryFeeTaxCents      Int
  totalTaxCents            Int
  totalCents               Int
  requestSnapshot          Json
  responseSnapshot         Json
  expiresAt                DateTime
  consumedAt               DateTime?
  invalidatedAt            DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  nexusRule                TaxNexusRule?      @relation(fields: [nexusRuleId], references: [id], onDelete: Restrict)
  checkoutAttempt          CheckoutAttempt?

  @@index([status, expiresAt])
  @@index([cartHash, destinationHash, expiresAt])
  @@index([provider, providerQuoteId])
  @@index([nexusRuleId])
}

model WebhookEvent {
  id          String    @id
  provider    String
  eventType   String
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
  raw         Json

  @@index([provider, receivedAt])
  @@index([processedAt])
}

model CheckoutAttempt {
  id                      String                @id @default(cuid())
  checkoutVersion         Int                   @default(1)
  idempotencyKey          String                @unique
  cartId                  String?
  requestHash             String
  status                  CheckoutAttemptStatus @default(RECEIVED)
  quote                   Json?
  validationErrors        Json?
  fulfillmentMode         FulfillmentMode?
  squareOrderId           String?               @unique
  squarePaymentLinkId     String?               @unique
  squareCheckoutUrl       String?
  orderproShippingOrderId String?               @unique
  shippingContext         Json?
  splitCheckoutContext    Json?
  taxQuoteId              String?               @unique
  taxContext              Json?
  hostedCheckoutCreatedAt DateTime?
  expiresAt               DateTime
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  cart                    Cart?                 @relation(fields: [cartId], references: [id], onDelete: Restrict)
  taxQuote                TaxQuote?             @relation(fields: [taxQuoteId], references: [id], onDelete: Restrict)
  capacityHolds           CapacityHold[]

  @@index([cartId])
  @@index([status, expiresAt])
  @@index([fulfillmentMode, hostedCheckoutCreatedAt])
}

model WebhookInboxEvent {
  id            String             @id @default(cuid())
  provider      String
  eventId       String
  eventType     String
  payload       Json
  status        WebhookInboxStatus @default(RECEIVED)
  attempts      Int                @default(0)
  receivedAt    DateTime           @default(now())
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  lockToken     String?
  processedAt   DateTime?
  error         String?
  updatedAt     DateTime           @updatedAt

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([provider, status, nextAttemptAt])
  @@index([status, lockedAt])
}

model AdminRateLimitBucket {
  id              String   @id @default(cuid())
  scope           String
  keyHash         String
  windowStartedAt DateTime
  windowMs        Int
  count           Int      @default(1)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scope, keyHash, windowStartedAt])
  @@index([expiresAt])
}

model SlotOccurrence {
  id             String         @id @default(cuid())
  slotTemplateId String
  startsAt       DateTime
  endsAt         DateTime
  capacityPoints Int
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  slotTemplate   SlotTemplate   @relation(fields: [slotTemplateId], references: [id], onDelete: Restrict)
  capacityHolds  CapacityHold[]

  @@unique([slotTemplateId, startsAt])
  @@index([startsAt, active])
}

model CapacityHold {
  id                String             @id @default(cuid())
  slotOccurrenceId  String
  cartId            String?
  checkoutAttemptId String?
  orderId           String?
  status            CapacityHoldStatus @default(ACTIVE)
  capacityPoints    Int
  expiresAt         DateTime
  confirmedAt       DateTime?
  releasedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  slotOccurrence    SlotOccurrence     @relation(fields: [slotOccurrenceId], references: [id], onDelete: Restrict)
  cart              Cart?              @relation(fields: [cartId], references: [id], onDelete: Restrict)
  checkoutAttempt   CheckoutAttempt?   @relation(fields: [checkoutAttemptId], references: [id], onDelete: Restrict)
  order             OrderMirror?       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([slotOccurrenceId, status, expiresAt])
  @@index([cartId])
  @@index([checkoutAttemptId])
  @@index([orderId])
}

model DeliveryZoneVersion {
  id                 String              @id @default(cuid())
  deliveryZoneId     String
  versionNumber      Int
  polygonGeojson     Json
  serviceMode        String
  baseFeeCents       Int
  minimumOrderCents  Int
  maxDistanceMiles   Decimal?
  maxRouteMinutes    Int?
  priority           Int                 @default(0)
  activeDays         String[]
  cutoffMinutes      Int
  leadTimeMinutes    Int
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  createdAt          DateTime            @default(now())
  deliveryZone       DeliveryZone        @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  rateRules          DeliveryRateRule[]
  addressEvaluations AddressEvaluation[]

  @@unique([deliveryZoneId, versionNumber])
  @@index([effectiveFrom, effectiveTo])
}

model DeliveryRateRule {
  id                   String              @id @default(cuid())
  zoneVersionId        String
  name                 String
  minimumSubtotalCents Int?
  maximumSubtotalCents Int?
  feeCents             Int
  priority             Int                 @default(0)
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now())
  zoneVersion          DeliveryZoneVersion @relation(fields: [zoneVersionId], references: [id], onDelete: Restrict)

  @@index([zoneVersionId, active, priority])
}

model AddressEvaluation {
  id            String               @id @default(cuid())
  zoneVersionId String?
  addressHash   String
  input         Json
  eligible      Boolean
  reasonCode    String
  feeCents      Int?
  distanceMiles Decimal?
  routeMinutes  Int?
  evaluatedAt   DateTime             @default(now())
  expiresAt     DateTime
  zoneVersion   DeliveryZoneVersion? @relation(fields: [zoneVersionId], references: [id], onDelete: SetNull)

  @@index([addressHash, evaluatedAt])
  @@index([zoneVersionId])
}

model BalloonOrderDraft {
  id              String             @id @default(cuid())
  publicTokenHash String             @unique
  status          BalloonDraftStatus @default(DRAFT)
  currency        String             @default("USD")
  locationId      String?
  fulfillmentMode FulfillmentMode?
  requestDetails  Json?
  customerContact Json?
  deliveryAddress Json?
  requestedFor    DateTime?
  submittedAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  location        StoreLocation?     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines           BalloonDraftLine[]
  quotes          BalloonQuote[]

  @@index([status, expiresAt])
  @@index([locationId])
}

model BalloonDraftLine {
  id                String               @id @default(cuid())
  draftId           String
  squareVariationId String?
  componentKey      String
  quantity          Int
  configuration     Json
  capacityPoints    Int                  @default(0)
  sortOrder         Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  draft             BalloonOrderDraft    @relation(fields: [draftId], references: [id], onDelete: Restrict)
  variation         SquareItemVariation? @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)

  @@index([draftId, sortOrder])
  @@index([squareVariationId])
}

model BalloonQuote {
  id              String             @id @default(cuid())
  draftId         String
  versionNumber   Int
  status          BalloonQuoteStatus @default(ACTIVE)
  subtotalCents   Int
  feeCents        Int                @default(0)
  taxCents        Int                @default(0)
  totalCents      Int
  currency        String             @default("USD")
  pricingSnapshot Json
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime           @default(now())
  draft           BalloonOrderDraft  @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@unique([draftId, versionNumber])
  @@index([status, expiresAt])
}

model ReturnVerificationSession {
  id                 String          @id @default(cuid())
  publicTokenHash    String          @unique
  orderReferenceHash String
  emailHash          String
  postalCodeHash     String
  orderProOrderId    String?
  verifiedAt         DateTime?
  expiresAt          DateTime
  failedAttempts     Int             @default(0)
  orderSnapshot      Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  requests           ReturnRequest[]

  @@index([orderReferenceHash, createdAt])
  @@index([expiresAt])
}

model ReturnRequest {
  id                          String                    @id @default(cuid())
  rmaNumber                   String                    @unique
  orderProRmaId               String?                   @unique
  verificationSessionId       String
  idempotencyKey              String                    @unique
  requestHash                 String
  orderProOrderId             String
  orderNumber                 String
  status                      ReturnRequestStatus       @default(REQUESTED)
  policyVersion               String
  businessTimeZone            String
  confirmedDeliveryAt         DateTime?
  currency                    String                    @default("USD")
  merchandiseRefundCents      Int
  estimatedTaxRefundCents     Int
  discountAdjustmentCents     Int                       @default(0)
  refundableOriginalFeesCents Int                       @default(0)
  originalShippingCents       Int                       @default(0)
  originalLocalDeliveryCents  Int                       @default(0)
  labelPayer                  ReturnLabelPayer
  acceptedLabelDeductionCents Int                       @default(0)
  estimatedNetRefundCents     Int
  quoteSnapshot               Json
  policyAcceptedAt            DateTime
  conditionAcceptedAt         DateTime
  labelDeductionAcceptedAt    DateTime?
  shippoShipmentId            String?
  shippoRateId                String?
  shippoTransactionId         String?                   @unique
  shippoCarrier               String?
  shippoServiceLevel          String?
  trackingNumber              String?                   @unique
  labelCostCents              Int?
  labelCurrency               String?
  privateLabelUrl             String?
  labelExpiresAt              DateTime?
  squarePaymentId             String?
  squareRefundId              String?                   @unique
  squareRefundAmountCents     Int?
  squareRefundCurrency        String?
  squareRefundStatus          String?
  finalApprovedRefundCents    Int?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  verificationSession         ReturnVerificationSession @relation(fields: [verificationSessionId], references: [id], onDelete: Restrict)
  items                       ReturnRequestItem[]
  events                      ReturnStatusEvent[]

  @@index([verificationSessionId])
  @@index([orderProOrderId, createdAt])
  @@index([status, updatedAt])
}

model ReturnRequestItem {
  id                        String             @id @default(cuid())
  returnRequestId           String
  orderLineId               String
  squareVariationId         String?
  sku                       String?
  upc                       String?
  name                      String
  variant                   String?
  quantity                  Int
  reason                    String
  customerComment           String?
  evidenceReferences        Json
  decision                  ReturnLineDecision
  decisionReason            String?
  declaredUnused            Boolean
  declaredOriginalPackaging Boolean
  declaredSealUnopened      Boolean
  partyOpened               Boolean            @default(false)
  merchandiseRefundCents    Int
  estimatedTaxRefundCents   Int
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  returnRequest             ReturnRequest      @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderLineId])
  @@index([returnRequestId])
}

model ReturnStatusEvent {
  id              String              @id @default(cuid())
  returnRequestId String
  status          ReturnRequestStatus
  source          String
  externalEventId String?
  details         Json?
  occurredAt      DateTime
  createdAt       DateTime            @default(now())
  returnRequest   ReturnRequest       @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@unique([source, externalEventId])
  @@index([returnRequestId, occurredAt])
}

model CustomerAccount {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  firstName               String?
  lastName                String?
  squareCustomerId        String?                  @unique
  termsAcceptedAt         DateTime
  termsVersion            String
  marketingEmailConsent   Boolean                  @default(false)
  marketingConsentAt      DateTime?
  marketingConsentSource  String?
  marketingConsentVersion String?
  marketingUnsubscribedAt DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                CustomerSession[]
  consentEvents           CustomerConsentEvent[]
  notes                   CustomerNote[]
  privacyRequests         CustomerPrivacyRequest[]

  @@index([squareCustomerId])
  @@index([createdAt])
}

model CustomerLoginChallenge {
  id                        String    @id @default(cuid())
  email                     String
  codeHash                  String
  attempts                  Int       @default(0)
  termsVersion              String
  marketingConsentRequested Boolean   @default(false)
  marketingConsentVersion   String?
  source                    String
  expiresAt                 DateTime
  consumedAt                DateTime?
  createdAt                 DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model CustomerSession {
  id                String          @id @default(cuid())
  customerAccountId String
  tokenHash         String          @unique
  expiresAt         DateTime
  lastSeenAt        DateTime        @default(now())
  revokedAt         DateTime?
  createdAt         DateTime        @default(now())
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, expiresAt])
  @@index([expiresAt])
}

model CustomerConsentEvent {
  id                String          @id @default(cuid())
  customerAccountId String
  consentType       String
  granted           Boolean
  source            String
  policyVersion     String
  occurredAt        DateTime        @default(now())
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, occurredAt])
  @@index([consentType, occurredAt])
}

model CustomerNote {
  id                String          @id @default(cuid())
  customerAccountId String
  authorAdminUserId String?
  body              String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  authorAdminUser   AdminUser?      @relation("CustomerNoteAuthor", fields: [authorAdminUserId], references: [id], onDelete: SetNull)

  @@index([customerAccountId, createdAt])
  @@index([authorAdminUserId])
}

model CustomerPrivacyRequest {
  id                String                       @id @default(cuid())
  customerAccountId String
  requestType       CustomerPrivacyRequestType
  status            CustomerPrivacyRequestStatus @default(REQUESTED)
  requestedById     String?
  resolvedById      String?
  resolutionNote    String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  completedAt       DateTime?
  customerAccount   CustomerAccount              @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  requestedBy       AdminUser?                   @relation("PrivacyRequestCreator", fields: [requestedById], references: [id], onDelete: SetNull)
  resolvedBy        AdminUser?                   @relation("PrivacyRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([customerAccountId, createdAt])
  @@index([status, requestType])
  @@index([requestedById])
  @@index([resolvedById])
}

model AdminUser {
  id                        String                   @id @default(cuid())
  email                     String                   @unique
  displayName               String?
  passwordHash              String?
  role                      AdminRole
  status                    AdminUserStatus          @default(INVITED)
  locationScopeMode         AdminLocationScopeMode   @default(ALL)
  locationId                String?
  mfaEnabled                Boolean                  @default(false)
  mfaSecretEncrypted        String?
  authVersion               Int                      @default(1)
  lastLoginAt               DateTime?
  notificationsLastSeenAt   DateTime?
  invitedAt                 DateTime?
  activatedAt               DateTime?
  suspendedAt               DateTime?
  operationsRole            OperationsRole?
  operationsLocationIds     String[]                 @default([])
  operationsAccessStatus    OperationsAccessStatus   @default(NONE)
  operationsExternalSubject String?
  operationsRequestedAt     DateTime?
  operationsLastSyncedAt    DateTime?
  operationsSyncError       String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  auditLogs                 AuditLog[]
  cmsVersionsCreated        CmsContentVersion[]      @relation("CmsVersionCreatedBy")
  cmsVersionsPublished      CmsContentVersion[]      @relation("CmsVersionPublishedBy")
  location                  StoreLocation?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationScopes            AdminUserLocationScope[]
  sessions                  AdminSession[]
  recoveryCodes             AdminRecoveryCode[]
  invitations               AdminUserInvitation[]    @relation("AdminInvitationUser")
  invitationsCreated        AdminUserInvitation[]    @relation("AdminInvitationCreator")
  passwordResets            AdminPasswordReset[]
  customerNotesWritten      CustomerNote[]           @relation("CustomerNoteAuthor")
  privacyRequestsCreated    CustomerPrivacyRequest[] @relation("PrivacyRequestCreator")
  privacyRequestsResolved   CustomerPrivacyRequest[] @relation("PrivacyRequestResolver")

  @@index([locationId])
  @@index([status, role])
  @@index([operationsAccessStatus])
}

model AdminUserLocationScope {
  adminUserId String
  locationId  String
  createdAt   DateTime      @default(now())
  adminUser   AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  location    StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([adminUserId, locationId])
  @@index([locationId])
}

model AdminSession {
  id            String    @id @default(cuid())
  adminUserId   String
  tokenHash     String    @unique
  authVersion   Int
  mfaVerified   Boolean   @default(false)
  ipHash        String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  idleExpiresAt DateTime
  revokedAt     DateTime?
  revokedReason String?
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, revokedAt])
  @@index([expiresAt])
  @@index([idleExpiresAt])
}

model AdminRecoveryCode {
  id          String    @id @default(cuid())
  adminUserId String
  codeHash    String    @unique
  createdAt   DateTime  @default(now())
  usedAt      DateTime?
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, usedAt])
}

model AdminUserInvitation {
  id          String     @id @default(cuid())
  adminUserId String
  tokenHash   String     @unique
  createdById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())
  adminUser   AdminUser  @relation("AdminInvitationUser", fields: [adminUserId], references: [id], onDelete: Cascade)
  createdBy   AdminUser? @relation("AdminInvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([adminUserId, expiresAt])
  @@index([createdById])
}

model AdminPasswordReset {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model NotificationTemplateVersion {
  id          String                      @id @default(cuid())
  templateKey String
  version     Int
  name        String
  channel     NotificationChannel         @default(EMAIL)
  subject     String
  bodyText    String
  variables   String[]                    @default([])
  status      NotificationTemplateStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  deliveries  NotificationDeliveryEvent[]

  @@unique([templateKey, version])
  @@index([templateKey, status, version])
}

model NotificationDeliveryEvent {
  id                String                       @id @default(cuid())
  templateVersionId String?
  eventType         String
  channel           NotificationChannel
  recipientHash     String
  provider          String?
  providerMessageId String?                      @unique
  status            NotificationDeliveryStatus
  errorCode         String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  templateVersion   NotificationTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)

  @@index([eventType, status, createdAt])
  @@index([templateVersionId, createdAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id])

  @@index([actorId])
}
