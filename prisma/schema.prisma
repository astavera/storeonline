generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FulfillmentMode {
  PICKUP
  LOCAL_DELIVERY
  SHIPPING
}

enum FulfillmentStatus {
  NEW
  PAID
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  WAREHOUSE_PICKING
  PACKED
  LABEL_CREATED
  SHIPPED
  CANCELLED
  FAILED
}

enum AdminRole {
  OWNER
  MANAGER
  STORE_STAFF
  DELIVERY_STAFF
  WAREHOUSE_STAFF
  VIEWER
}

enum CmsPublishStatus {
  DRAFT
  PREVIEW
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ProductWebStatus {
  DRAFT
  NEEDS_REVIEW
  NEEDS_PLACEMENT
  PUBLISHED
  HIDDEN
  ARCHIVED_WEB_ONLY
}

enum ProductPlacementType {
  DEPARTMENT
  HOLIDAY
  BALLOON_SECTION
  HOMEPAGE_SECTION
  PRODUCT_GROUP
  SEARCH_GROUP
  PROMO_SECTION
}

enum DescriptionSource {
  SQUARE
  WEBSITE_OVERRIDE
  GENERATED_DRAFT
  ADMIN_APPROVED
  EMPTY
}

enum DescriptionStatus {
  READY
  NEEDS_REVIEW
  MISSING
  OUTDATED_SQUARE_CHANGED
}

enum CheckoutAttemptStatus {
  RECEIVED
  VALIDATING
  VALIDATED
  REJECTED
  EXPIRED
  COMPLETED
}

enum WebhookInboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum CapacityHoldStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum BalloonDraftStatus {
  DRAFT
  SUBMITTED
  QUOTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum BalloonQuoteStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  SUPERSEDED
}

model StoreLocation {
  id                         String              @id @default(cuid())
  squareLocationId           String?             @unique
  slug                       String              @unique
  name                       String
  address                    String
  phone                      String?
  pickupEnabled              Boolean             @default(true)
  localDeliveryEnabled       Boolean             @default(true)
  shippingFulfillmentEnabled Boolean             @default(false)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  deliveryZones              DeliveryZone[]
  slotTemplates              SlotTemplate[]
  fulfillmentTasks           FulfillmentTask[]
  adminUsers                 AdminUser[]
  balloonOrderDrafts         BalloonOrderDraft[]
}

model SquareCatalogObject {
  id                      String                   @id
  type                    String
  version                 BigInt?
  reportingCategoryId     String?
  categoryIds             String[]
  name                    String?
  descriptionHtml         String?
  descriptionPlaintext    String?
  squareDescriptionHash   String?
  lastDescriptionSyncedAt DateTime?
  raw                     Json
  syncedAt                DateTime                 @default(now())
  deletedAt               DateTime?
  itemVariations          SquareItemVariation[]
  images                  ProductImagePreference[]
}

model SquareItemVariation {
  id                    String                        @id
  itemId                String
  name                  String
  sku                   String?
  upc                   String?
  priceMoney            Json?
  raw                   Json
  syncedAt              DateTime                      @default(now())
  deletedAt             DateTime?
  item                  SquareCatalogObject           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryCounts       SquareInventoryCount[]
  departmentAssignments ProductDepartmentAssignment[]
  holidayAssignments    ProductHolidayAssignment[]
  brandAssignments      ProductBrandAssignment[]
  productOverride       ProductOverride?
  cartItems             CartItem[]
  orderItems            OrderItemMirror[]
  balloonDraftLines     BalloonDraftLine[]

  @@index([itemId])
  @@index([deletedAt])
}

model SquareInventoryCount {
  id               String              @id @default(cuid())
  variationId      String
  squareLocationId String
  quantity         Decimal
  state            String
  calculatedAt     DateTime
  syncedAt         DateTime            @default(now())
  variation        SquareItemVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@unique([variationId, squareLocationId, state])
  @@index([squareLocationId, state])
}

model SquareCatalogSyncState {
  environment     String    @id
  latestTime      String?
  lastStartedAt   DateTime?
  lastCompletedAt DateTime?
  lastError       String?
  lockedAt        DateTime?
  lockToken       String?
  updatedAt       DateTime  @updatedAt
}

model Department {
  id                 String                        @id @default(cuid())
  slug               String                        @unique
  titleEn            String
  shortTitleEn       String
  descriptionEn      String
  heroTitleEn        String
  heroSubtitleEn     String
  seoTitleEn         String
  seoDescriptionEn   String
  heroImageUrl       String?
  mobileHeroImageUrl String?
  accentColorToken   String
  sortOrder          Int
  navigationPriority String
  isPrimaryNav       Boolean                       @default(false)
  isVisible          Boolean                       @default(true)
  layoutPreset       String
  productGridPreset  String
  productCardVariant String
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  products           ProductDepartmentAssignment[]
}

model Holiday {
  id                 String                     @id @default(cuid())
  slug               String                     @unique
  titleEn            String
  shortTitleEn       String
  descriptionEn      String
  heroTitleEn        String
  heroSubtitleEn     String
  seoTitleEn         String
  seoDescriptionEn   String
  heroImageUrl       String?
  mobileHeroImageUrl String?
  accentColorToken   String
  customAccentColor  String?
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean                    @default(false)
  isVisible          Boolean                    @default(true)
  sortOrder          Int
  layoutPreset       String
  productGridPreset  String
  productCardVariant String
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  products           ProductHolidayAssignment[]

  @@index([isActive, isVisible, startDate, endDate])
}

model WebsiteBrand {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  name               String
  description        String
  logoUrl            String?
  imageAlt           String?
  squareVendorIds    String[]
  visible            Boolean                  @default(false)
  featuredOnHomepage Boolean                  @default(false)
  sortOrder          Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  products           ProductBrandAssignment[]

  @@index([visible, sortOrder])
}

model ProductBrandAssignment {
  id                String              @id @default(cuid())
  brandId           String
  squareVariationId String
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  brand             WebsiteBrand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variation         SquareItemVariation @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)

  @@unique([brandId, squareVariationId])
  @@index([brandId, sortOrder])
  @@index([squareVariationId])
}

model ProductDepartmentAssignment {
  id                String              @id @default(cuid())
  departmentId      String
  squareVariationId String
  sortOrder         Int                 @default(0)
  isFeatured        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  department        Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  variation         SquareItemVariation @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)

  @@unique([departmentId, squareVariationId])
  @@index([squareVariationId])
}

model ProductHolidayAssignment {
  id                String              @id @default(cuid())
  holidayId         String
  squareVariationId String
  sortOrder         Int                 @default(0)
  badge             String?
  createdAt         DateTime            @default(now())
  holiday           Holiday             @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  variation         SquareItemVariation @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)

  @@unique([holidayId, squareVariationId])
  @@index([squareVariationId])
}

model ProductOverride {
  id                            String                    @id @default(cuid())
  squareVariationId             String                    @unique
  webVisible                    Boolean                   @default(false)
  webStatus                     ProductWebStatus          @default(NEEDS_PLACEMENT)
  seoTitleEn                    String?
  seoDescriptionEn              String?
  slug                          String?                   @unique
  displayNameEn                 String?
  webShortDescriptionEn         String?
  webDescriptionEn              String?
  badgeEn                       String?
  featured                      Boolean                   @default(false)
  productCardStyle              String?
  ageGroups                     String[]                  @default([])
  websiteSurfaces               String[]                  @default([])
  fulfillmentModes              FulfillmentMode[]
  pickupAllowed                 Boolean                   @default(false)
  localDeliveryAllowed          Boolean                   @default(false)
  shippingAllowed               Boolean                   @default(false)
  allowedLocationIds            String[]
  warehouseRequired             Boolean                   @default(false)
  inflated                      Boolean                   @default(false)
  fragile                       Boolean                   @default(false)
  requiresBalloonPrep           Boolean                   @default(false)
  prepTimeMinutes               Int?
  capacityPoints                Int?
  descriptionSource             DescriptionSource         @default(EMPTY)
  descriptionStatus             DescriptionStatus         @default(MISSING)
  useSquareDescription          Boolean                   @default(true)
  lockWebDescription            Boolean                   @default(false)
  squareDescriptionHash         String?
  lastSquareDescriptionSyncedAt DateTime?
  isBalloonComponent            Boolean                   @default(false)
  isShippable                   Boolean                   @default(true)
  publishedAt                   DateTime?
  unpublishedAt                 DateTime?
  scheduledPublishAt            DateTime?
  scheduledUnpublishAt          DateTime?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  variation                     SquareItemVariation       @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)
  placements                    WebsiteProductPlacement[]

  @@index([webStatus, webVisible])
}

model WebsiteProductPlacement {
  id                  String               @id @default(cuid())
  squareVariationId   String
  placementType       ProductPlacementType
  placementTargetId   String?
  placementTargetSlug String
  sectionId           String
  sortOrder           Int                  @default(0)
  isFeatured          Boolean              @default(false)
  isPrimary           Boolean              @default(false)
  visible             Boolean              @default(false)
  startsAt            DateTime?
  endsAt              DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  productOverride     ProductOverride      @relation(fields: [squareVariationId], references: [squareVariationId], onDelete: Cascade)

  @@index([placementType, placementTargetSlug])
  @@index([placementType, placementTargetSlug, visible, sortOrder])
  @@index([squareVariationId])
}

model ProductPlacementRule {
  id                    String               @id @default(cuid())
  name                  String
  active                Boolean              @default(true)
  suggestOnly           Boolean              @default(true)
  matchField            String
  matchOperator         String
  matchValue            String
  placementType         ProductPlacementType
  placementTargetSlug   String
  fulfillmentSuggestion Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model CmsContentVersion {
  id                   String              @id @default(cuid())
  entityType           String
  entityId             String
  versionNumber        Int
  status               CmsPublishStatus    @default(DRAFT)
  title                String?
  payload              Json
  createdById          String?
  publishedById        String?
  publishedAt          DateTime?
  scheduledPublishAt   DateTime?
  scheduledUnpublishAt DateTime?
  rollbackOfVersionId  String?
  createdAt            DateTime            @default(now())
  createdBy            AdminUser?          @relation("CmsVersionCreatedBy", fields: [createdById], references: [id])
  publishedBy          AdminUser?          @relation("CmsVersionPublishedBy", fields: [publishedById], references: [id])
  rollbackOfVersion    CmsContentVersion?  @relation("CmsVersionRollback", fields: [rollbackOfVersionId], references: [id], onDelete: SetNull)
  rollbackVersions     CmsContentVersion[] @relation("CmsVersionRollback")

  @@unique([entityType, entityId, versionNumber])
  @@index([entityType, entityId, status])
  @@index([createdById])
  @@index([publishedById])
  @@index([rollbackOfVersionId])
}

model MediaAsset {
  id                String   @id @default(cuid())
  source            String
  sourceId          String?
  url               String
  altTextEn         String?
  mimeType          String?
  width             Int?
  height            Int?
  hiddenFromWebsite Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([source, sourceId])
}

model ProductImagePreference {
  id              String              @id @default(cuid())
  catalogObjectId String
  imageUrl        String
  altTextEn       String?
  sortOrder       Int                 @default(0)
  isPrimary       Boolean             @default(false)
  cropPreset      String?
  createdAt       DateTime            @default(now())
  catalogObject   SquareCatalogObject @relation(fields: [catalogObjectId], references: [id], onDelete: Cascade)

  @@index([catalogObjectId])
}

model Cart {
  id               String            @id @default(cuid())
  sessionId        String            @unique
  currency         String            @default("USD")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            CartItem[]
  slotHolds        SlotHold[]
  checkoutAttempts CheckoutAttempt[]
  capacityHolds    CapacityHold[]
}

model CartItem {
  id                String              @id @default(cuid())
  cartId            String
  squareVariationId String
  quantity          Int
  fulfillmentMode   FulfillmentMode?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cart              Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variation         SquareItemVariation @relation(fields: [squareVariationId], references: [id])

  @@index([cartId])
  @@index([squareVariationId])
}

model OrderMirror {
  id               String            @id @default(cuid())
  squareOrderId    String?           @unique
  squarePaymentId  String?           @unique
  customerEmail    String?
  customerPhone    String?
  currency         String            @default("USD")
  totalMoney       Json
  status           String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            OrderItemMirror[]
  fulfillmentTasks FulfillmentTask[]
  slotHolds        SlotHold[]
  capacityHolds    CapacityHold[]

  @@index([status, createdAt])
}

model OrderItemMirror {
  id                String              @id @default(cuid())
  orderId           String
  squareVariationId String
  name              String
  quantity          Int
  priceMoney        Json
  order             OrderMirror         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variation         SquareItemVariation @relation(fields: [squareVariationId], references: [id])

  @@index([orderId])
  @@index([squareVariationId])
}

model FulfillmentTask {
  id              String            @id @default(cuid())
  orderId         String
  locationId      String?
  mode            FulfillmentMode
  status          FulfillmentStatus @default(NEW)
  assignedRole    AdminRole?
  capacityPoints  Int               @default(1)
  deliveryAddress Json?
  shippingAddress Json?
  trackingNumber  String?
  carrier         String?
  labelUrl        String?
  dueAt           DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           OrderMirror       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  location        StoreLocation?    @relation(fields: [locationId], references: [id])

  @@index([orderId])
  @@index([locationId])
  @@index([status, dueAt])
}

model DeliveryZone {
  id                String                @id @default(cuid())
  locationId        String
  name              String
  polygonGeojson    Json
  version           Int                   @default(1)
  active            Boolean               @default(true)
  serviceMode       String
  baseFeeCents      Int
  minimumOrderCents Int
  maxDistanceMiles  Decimal?
  maxRouteMinutes   Int?
  priority          Int                   @default(0)
  activeDays        String[]
  cutoffMinutes     Int
  leadTimeMinutes   Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  location          StoreLocation         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  versions          DeliveryZoneVersion[]

  @@index([locationId])
  @@index([locationId, active, priority])
}

model SlotTemplate {
  id              String           @id @default(cuid())
  locationId      String
  fulfillmentMode FulfillmentMode
  dayOfWeek       Int
  startTime       String
  endTime         String
  capacityPoints  Int
  active          Boolean          @default(true)
  cutoffMinutes   Int
  leadTimeMinutes Int
  location        StoreLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  holds           SlotHold[]
  occurrences     SlotOccurrence[]

  @@index([locationId])
  @@index([locationId, fulfillmentMode, active, dayOfWeek])
}

model SlotHold {
  id             String       @id @default(cuid())
  slotTemplateId String
  cartId         String?
  orderId        String?
  capacityPoints Int
  expiresAt      DateTime
  confirmedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime     @default(now())
  slotTemplate   SlotTemplate @relation(fields: [slotTemplateId], references: [id], onDelete: Restrict)
  cart           Cart?        @relation(fields: [cartId], references: [id], onDelete: Restrict)
  order          OrderMirror? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([slotTemplateId])
  @@index([slotTemplateId, expiresAt])
  @@index([cartId])
  @@index([orderId])
}

model ShippingRateQuote {
  id           String   @id @default(cuid())
  provider     String
  carrier      String
  serviceLevel String
  amountCents  Int
  currency     String   @default("USD")
  addressHash  String
  expiresAt    DateTime
  raw          Json
  createdAt    DateTime @default(now())

  @@index([addressHash, expiresAt])
}

model WebhookEvent {
  id          String    @id
  provider    String
  eventType   String
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
  raw         Json

  @@index([provider, receivedAt])
  @@index([processedAt])
}

model CheckoutAttempt {
  id                      String                @id @default(cuid())
  idempotencyKey          String                @unique
  cartId                  String?
  requestHash             String
  status                  CheckoutAttemptStatus @default(RECEIVED)
  quote                   Json?
  validationErrors        Json?
  fulfillmentMode         FulfillmentMode?
  squareOrderId           String?               @unique
  squarePaymentLinkId     String?               @unique
  orderproShippingOrderId String?               @unique
  shippingContext         Json?
  hostedCheckoutCreatedAt DateTime?
  expiresAt               DateTime
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  cart                    Cart?                 @relation(fields: [cartId], references: [id], onDelete: Restrict)
  capacityHolds           CapacityHold[]

  @@index([cartId])
  @@index([status, expiresAt])
  @@index([fulfillmentMode, hostedCheckoutCreatedAt])
}

model WebhookInboxEvent {
  id            String             @id @default(cuid())
  provider      String
  eventId       String
  eventType     String
  payload       Json
  status        WebhookInboxStatus @default(RECEIVED)
  attempts      Int                @default(0)
  receivedAt    DateTime           @default(now())
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  lockToken     String?
  processedAt   DateTime?
  error         String?
  updatedAt     DateTime           @updatedAt

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([provider, status, nextAttemptAt])
  @@index([status, lockedAt])
}

model AdminRateLimitBucket {
  id              String   @id @default(cuid())
  scope           String
  keyHash         String
  windowStartedAt DateTime
  windowMs        Int
  count           Int      @default(1)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scope, keyHash, windowStartedAt])
  @@index([expiresAt])
}

model SlotOccurrence {
  id             String         @id @default(cuid())
  slotTemplateId String
  startsAt       DateTime
  endsAt         DateTime
  capacityPoints Int
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  slotTemplate   SlotTemplate   @relation(fields: [slotTemplateId], references: [id], onDelete: Restrict)
  capacityHolds  CapacityHold[]

  @@unique([slotTemplateId, startsAt])
  @@index([startsAt, active])
}

model CapacityHold {
  id                String             @id @default(cuid())
  slotOccurrenceId  String
  cartId            String?
  checkoutAttemptId String?
  orderId           String?
  status            CapacityHoldStatus @default(ACTIVE)
  capacityPoints    Int
  expiresAt         DateTime
  confirmedAt       DateTime?
  releasedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  slotOccurrence    SlotOccurrence     @relation(fields: [slotOccurrenceId], references: [id], onDelete: Restrict)
  cart              Cart?              @relation(fields: [cartId], references: [id], onDelete: Restrict)
  checkoutAttempt   CheckoutAttempt?   @relation(fields: [checkoutAttemptId], references: [id], onDelete: Restrict)
  order             OrderMirror?       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([slotOccurrenceId, status, expiresAt])
  @@index([cartId])
  @@index([checkoutAttemptId])
  @@index([orderId])
}

model DeliveryZoneVersion {
  id                 String              @id @default(cuid())
  deliveryZoneId     String
  versionNumber      Int
  polygonGeojson     Json
  serviceMode        String
  baseFeeCents       Int
  minimumOrderCents  Int
  maxDistanceMiles   Decimal?
  maxRouteMinutes    Int?
  priority           Int                 @default(0)
  activeDays         String[]
  cutoffMinutes      Int
  leadTimeMinutes    Int
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  createdAt          DateTime            @default(now())
  deliveryZone       DeliveryZone        @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  rateRules          DeliveryRateRule[]
  addressEvaluations AddressEvaluation[]

  @@unique([deliveryZoneId, versionNumber])
  @@index([effectiveFrom, effectiveTo])
}

model DeliveryRateRule {
  id                   String              @id @default(cuid())
  zoneVersionId        String
  name                 String
  minimumSubtotalCents Int?
  maximumSubtotalCents Int?
  feeCents             Int
  priority             Int                 @default(0)
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now())
  zoneVersion          DeliveryZoneVersion @relation(fields: [zoneVersionId], references: [id], onDelete: Restrict)

  @@index([zoneVersionId, active, priority])
}

model AddressEvaluation {
  id            String               @id @default(cuid())
  zoneVersionId String?
  addressHash   String
  input         Json
  eligible      Boolean
  reasonCode    String
  feeCents      Int?
  distanceMiles Decimal?
  routeMinutes  Int?
  evaluatedAt   DateTime             @default(now())
  expiresAt     DateTime
  zoneVersion   DeliveryZoneVersion? @relation(fields: [zoneVersionId], references: [id], onDelete: SetNull)

  @@index([addressHash, evaluatedAt])
  @@index([zoneVersionId])
}

model BalloonOrderDraft {
  id              String             @id @default(cuid())
  publicTokenHash String             @unique
  status          BalloonDraftStatus @default(DRAFT)
  currency        String             @default("USD")
  locationId      String?
  fulfillmentMode FulfillmentMode?
  requestDetails  Json?
  customerContact Json?
  deliveryAddress Json?
  requestedFor    DateTime?
  submittedAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  location        StoreLocation?     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines           BalloonDraftLine[]
  quotes          BalloonQuote[]

  @@index([status, expiresAt])
  @@index([locationId])
}

model BalloonDraftLine {
  id                String               @id @default(cuid())
  draftId           String
  squareVariationId String?
  componentKey      String
  quantity          Int
  configuration     Json
  capacityPoints    Int                  @default(0)
  sortOrder         Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  draft             BalloonOrderDraft    @relation(fields: [draftId], references: [id], onDelete: Restrict)
  variation         SquareItemVariation? @relation(fields: [squareVariationId], references: [id], onDelete: Restrict)

  @@index([draftId, sortOrder])
  @@index([squareVariationId])
}

model BalloonQuote {
  id              String             @id @default(cuid())
  draftId         String
  versionNumber   Int
  status          BalloonQuoteStatus @default(ACTIVE)
  subtotalCents   Int
  feeCents        Int                @default(0)
  taxCents        Int                @default(0)
  totalCents      Int
  currency        String             @default("USD")
  pricingSnapshot Json
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime           @default(now())
  draft           BalloonOrderDraft  @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@unique([draftId, versionNumber])
  @@index([status, expiresAt])
}

model AdminUser {
  id                   String              @id @default(cuid())
  email                String              @unique
  role                 AdminRole
  locationId           String?
  mfaEnabled           Boolean             @default(false)
  lastLoginAt          DateTime?
  createdAt            DateTime            @default(now())
  auditLogs            AuditLog[]
  cmsVersionsCreated   CmsContentVersion[] @relation("CmsVersionCreatedBy")
  cmsVersionsPublished CmsContentVersion[] @relation("CmsVersionPublishedBy")
  location             StoreLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([locationId])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id])

  @@index([actorId])
}
